@echo off
title SQM Quality System - Packaging Tool
chcp 65001 >nul

echo ====================================================================
echo        SQM 质量管理系统 - 自动化一键单文件打包程序
echo ====================================================================
echo.
echo 正在准备环境并执行自动化打包...
echo 产物将输出至: package\output\
echo.

cd /d "%~dp0"
python build_package.py

if errorlevel 1 (
    echo.
    echo ====================================================================
    echo [错误] 打包过程中出现异常，请查看上方详细输出。
    echo ====================================================================
    pause
    exit /b 1
)

echo.
echo ====================================================================
echo [成功] 打包完成！
echo 您可以直接复制 package\output\SQM质量管理系统.exe 到任意 Windows 电脑运行。
echo ====================================================================
echo.
pause
